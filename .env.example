# Copy to .env and fill in secrets. Never commit .env.
# Non-secret settings: config/local.json or config/prod.json (METAR_CONFIG_ENV).

SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional. Leave blank to use the bundled Postgres `db` service under Docker
# Compose. Set to a full PostgreSQL URL (e.g. a Supabase pooler URL) to override.
# A blank value is treated as unset.
DATABASE_URL=
# Live/E2E login (ordinary user — not a product admin role). Replaces deprecated ADMIN_*.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# F31 Auth (API) — Supabase Auth project URL for /auth/login + JWKS verify (ADR-033).
# Also used by F8 worker until F30 retargets writers to DATABASE_URL.
SUPABASE_URL=
# Optional JWKS override (API only). Default: {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Never set on the frontend. HS256 SUPABASE_JWT_SECRET is retired for product verify.
SUPABASE_JWKS_URL=

# F8 worker (apps/worker) — optional locally; required on Render worker service
SUPABASE_SERVICE_ROLE_KEY=
INGEST_POLLER_URL=
INGEST_POLL_INTERVAL_SEC=30

# F16–F19 dissemination egress (ADR-029). Comma-separated hostnames and/or CIDRs.
# Never put secrets here — pasted BYOC credentials are memory-only on preflight/send.
#
# Local / CI (recommended for wis2box harness F17 / T3.3–T3.4):
DISSEMINATION_EGRESS_ALLOWLIST=wis2box,127.0.0.1,127.0.0.0/8,localhost
#
# Render / prod:
#   - Leave empty for fail-closed (no user-URI egress) when not demoing.
#   - For live BYOC close-gate demos, set ONLY the exact Postgres / WIS2 / EDIS
#     SMTP hostnames (no wildcards, no secrets). Clear again after demos if desired.

# F17 wis2box Compose harness host ports (docker-compose.wis2box.yml profile wis2box).
WIS2BOX_MQTT_HOST_PORT=1883
WIS2BOX_HTTP_HOST_PORT=9080

# --- S019 mock BYOC (testing only; never commit real secrets) ---
# Copy mock placeholders into gitignored `.env` for local smoke:
#   E2E_USER_EMAIL=mock-e2e@example.test
#   E2E_USER_PASSWORD=mock-e2e-password-not-real
# Fixture shapes: docs/sessions/S019-dissemination-upload/fixtures/mock-byoc-destinations.json
# Test candidates: docs/sessions/S019-dissemination-upload/fixtures/byoc-test-candidates/
# Runner: make test-mock-byoc-smoke  (or scripts/deploy/run_mock_byoc_smoke.sh)
# Compose mock sinks (Postgres/MySQL/SQL Server/MailHog/F19 + wis2box):
#   make compose-mock-byoc-all-up && make test-mock-byoc-all-sinks
# Host ports (optional overrides):
# BYOC_POSTGRES_HOST_PORT=25432
# BYOC_MYSQL_HOST_PORT=13306
# BYOC_SQLSERVER_HOST_PORT=11433
# BYOC_SMTP_HOST_PORT=11025
# BYOC_MAILHOG_UI_HOST_PORT=18025
# BYOC_F19_HOST_PORT=19099
# Live destination BYOC waived for EV-014 close when using mocks (D-S019-EV014-Q15-mock-waive).
