# Copy to .env and fill in secrets. Never commit .env.
# Non-secret settings: config/local.json or config/prod.json (METAR_CONFIG_ENV).

SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional. Leave blank to use the bundled Postgres `db` service under Docker
# Compose. Set to a full PostgreSQL URL (e.g. a Supabase pooler URL) to override.
# A blank value is treated as unset.
DATABASE_URL=
# Live/E2E login (ordinary user — not a product admin role). Replaces deprecated ADMIN_*.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# F8 worker (apps/worker) — optional locally; required on Render worker service
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INGEST_POLLER_URL=
INGEST_POLL_INTERVAL_SEC=30
