#!/usr/bin/env python3
"""Cursor stop hook: run cheap lint evidence, fail open to the editor. [Corpus: hook-contract]"""

from __future__ import annotations

import hashlib
import json
import os
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path

SKILLS = Path.home() / ".cursor" / "skills"
EVIDENCE_ROOT = Path.home() / ".cursor" / "workflow" / "_hook-evidence"


def git_root(start: Path) -> Path | None:
    proc = subprocess.run(
        ["git", "-C", str(start), "rev-parse", "--show-toplevel"],
        check=False,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        return None
    return Path(proc.stdout.strip())


def main() -> int:
    # Consume stdin JSON from Cursor; ignore contents for v1.
    sys.stdin.read()
    cwd = Path(os.environ.get("CURSOR_PROJECT_DIR") or Path.cwd())
    root = git_root(cwd) or cwd
    key = hashlib.sha256(str(root).encode()).hexdigest()[:12]
    dest = EVIDENCE_ROOT / key
    dest.mkdir(parents=True, exist_ok=True)
    makefile = root / "Makefile"
    detail = "na-no-makefile"
    exit_code = 0
    if makefile.is_file() and "lint" in makefile.read_text(encoding="utf-8", errors="replace"):
        proc = subprocess.run(
            ["make", "-C", str(root), "lint"],
            check=False,
            capture_output=True,
            text=True,
            timeout=120,
        )
        (dest / "lint.log").write_text(proc.stdout + proc.stderr, encoding="utf-8")
        exit_code = proc.returncode
        detail = "make-lint"
    payload = {
        "when": datetime.now(UTC).isoformat(),
        "root": str(root),
        "verdict": "PASS" if exit_code == 0 else "FAIL",
        "detail": detail,
        "exit": exit_code,
    }
    (dest / "lint.json").write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    # Fail open for the editor; evidence records FAIL.
    print(json.dumps({"continue": True}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
