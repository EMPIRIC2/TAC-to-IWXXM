# Auth Service Configuration
# ============================
# Copy this file to .env and customize for your environment
# IMPORTANT: .env contains secrets and should NOT be committed to version control!
# Add .env to .gitignore to prevent accidental exposure of secrets.

# Supabase Configuration (Required for Supabase auth proxy mode)
# Get these from your Supabase Dashboard → Project Settings → API
# SUPABASE_URL: Your project URL (safe to share)
# SUPABASE_ANON_KEY: Anon key (safe for frontend, restricted permissions)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-jwt-anon-key-here

# Database Configuration (for backend services only)
# DATABASE_URL connects to Supabase PostgreSQL with:
# - Transaction pooler (port 6543): Best for serverless/stateless apps
# - Session pooler (port 5432): Better for long-lived connections
# WARNING: Contains database password - NEVER commit to version control!
# Use environment variables in production (Docker secrets, cloud provider secrets)
DATABASE_URL=postgresql+psycopg2://user:password@host:6543/database

# Frontend Configuration (for password reset redirect links)
# This is where users are redirected after password reset
FRONTEND_BASE_URL=http://localhost:8000

# Demo Users for Testing and Development
# ========================================
# These credentials can be used for testing the auth service locally
# DO NOT use these in production!
# Format: DEMO_[ROLE]_[FIELD]

# Demo Admin User
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=Admin123!SecurePass
DEMO_ADMIN_NAME=Demo Administrator
DEMO_ADMIN_ADDRESS=123 Demo Street, Test City

# Demo Regular User
DEMO_USER_EMAIL=user@demo.local
DEMO_USER_USERNAME=demouser
DEMO_USER_PASSWORD=User123!SecurePass
DEMO_USER_NAME=Demo User
DEMO_USER_ADDRESS=456 User Avenue, Test City

# Demo Test User (for automated testing)
DEMO_TEST_EMAIL=test@demo.local
DEMO_TEST_USERNAME=testuser
DEMO_TEST_PASSWORD=Test123!SecurePass
DEMO_TEST_NAME=Test User
DEMO_TEST_ADDRESS=789 Test Lane, Test City

# Service Configuration
# =====================

# Enable demo mode (automatically creates demo users on startup)
DEMO_MODE=true

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_LEVEL=INFO

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001

# Security Settings
# =================

# Minimum password length (default: 8)
MIN_PASSWORD_LENGTH=8

# Minimum username length (default: 3)
MIN_USERNAME_LENGTH=3

# Maximum username length (default: 50)
MAX_USERNAME_LENGTH=50

# Token blacklist enabled (for logout functionality)
ENABLE_TOKEN_BLACKLIST=false

# Development vs Production
# ==========================

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (never enable in production)
DEBUG=true

# Example Supabase Integration
# =============================
# If integrating with Supabase for external auth

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
# SUPABASE_JWT_SECRET=your-jwt-secret

# Testing Configuration
# =====================

# Test database URL (used by pytest)
TEST_DATABASE_URL=sqlite:///:memory:

# Skip database initialization on import (for testing)
SKIP_DB_INIT=false

# Example Production Configuration
# =================================
# Uncomment and customize for production deployment

# DATABASE_URL=postgresql://produser:strongpassword@db.example.com:5432/auth_production
# AUTH_JWT_SECRET=very-long-random-secret-generated-by-secure-method
# AUTH_JWT_EXPIRE_MINUTES=15
# AUTH_RESET_EXPIRE_MINUTES=10
# FRONTEND_BASE_URL=https://app.example.com
# ENVIRONMENT=production
# DEBUG=false
# DEMO_MODE=false
# LOG_LEVEL=WARNING
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# Docker Configuration
# ====================
# These are set automatically by docker-compose
# Override only if running outside Docker

# SERVICE_NAME=auth-service
# SERVICE_VERSION=0.1.0
# SERVICE_PORT=8000
