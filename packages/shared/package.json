{
  "name": "@metar/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run stryker.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm -w exec eslint packages/shared/src packages/shared/tests --max-warnings 0",
    "format:check": "pnpm -w exec prettier --check \"packages/shared/src/**/*.ts\" \"packages/shared/tests/**/*.ts\""
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "typescript": "5.9.3",
    "@vitest/coverage-v8": "4.1.11",
    "vitest": "4.1.11"
  }
}
