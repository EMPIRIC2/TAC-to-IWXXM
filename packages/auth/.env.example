# packages/auth — server-side Auth env (F31 / ADR-033). Never commit real secrets.
# Copied into API runtime via root `.env` / Compose / Render — not a separate deployable.

# Required for /auth/login (password grant) and default JWKS derivation.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Optional JWKS override (API only). Default:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Do not use SUPABASE_JWT_SECRET / HS256 for product verify (JWKS-only).
SUPABASE_JWKS_URL=
