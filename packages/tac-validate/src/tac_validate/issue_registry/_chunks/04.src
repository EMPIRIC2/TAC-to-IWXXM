    ),
    _row(
        "AUTO_VISIBILITY_NOT_OBSERVABLE",
        "warning",
        "{product} AUTO report encodes visibility as //// (temporarily missing or incorrect). In AUTO reports, prevailing visibility is the best practicable runway and touchdown indication.",
