FROM ubuntu:20.04

# Prevent interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

# Install Java and required tools
RUN apt-get update && apt-get install -y \
    openjdk-11-jre-headless \
    wget \
    unzip \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Saxon XSLT2 processor and dependencies
RUN mkdir -p /opt/saxon && \
    wget -O /opt/saxon/saxon-he-11.4.jar https://repo1.maven.org/maven2/net/sf/saxon/Saxon-HE/11.4/Saxon-HE-11.4.jar && \
    wget -O /opt/saxon/xmlresolver-4.4.1.jar https://repo1.maven.org/maven2/org/xmlresolver/xmlresolver/4.4.1/xmlresolver-4.4.1.jar && \
    chmod +x /opt/saxon/saxon-he-11.4.jar

# Download Schematron ISO SVRL compiler
RUN mkdir -p /opt/schematron && \
    wget -O /tmp/schematron.zip https://github.com/Schematron/schematron/releases/download/2024-10-19/schematron-release.zip 2>/dev/null || \
    echo "Note: Could not download latest Schematron, will use fallback" && \
    if [ -f /tmp/schematron.zip ]; then unzip -q /tmp/schematron.zip -d /opt/schematron && rm /tmp/schematron.zip; fi

# Copy validation script
COPY schematron_validator.py /usr/local/bin/

WORKDIR /work

ENTRYPOINT ["python3", "/usr/local/bin/schematron_validator.py"]

