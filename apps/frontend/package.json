{
  "name": "@metar/frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:supabase": "tsx src/test-supabase.ts",
    "test:e2e": "NODE_PATH=./node_modules playwright test",
    "test:e2e:ui": "NODE_PATH=./node_modules playwright test --ui",
    "test:e2e:debug": "NODE_PATH=./node_modules DEBUG=1 playwright test --debug",
    "test:e2e:headed": "NODE_PATH=./node_modules playwright test --headed",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "audit": "pnpm audit",
    "audit:ci": "pnpm audit --audit-level=low"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
